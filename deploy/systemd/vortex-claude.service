# Template: replace /home/user, <checkout> and <opencode-peer-id> before installing.
# Install at ~/.config/systemd/user/vortex-claude.service.
# Use a persistent, verified deployment checkout, separate from agent worktrees.
# Model wakes remain off unless <checkout>/.vortex/claude/wake exists.
[Unit]
Description=VORTEX service for owner claude
Wants=vortex-router.service
After=vortex-router.service

[Service]
WorkingDirectory=/home/user/.local/share/vortex-live
Environment=PATH=/home/user/.bun/bin:/home/user/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/user/.bun/bin/bun src/cli.ts serve --dir <checkout>/.vortex/claude --name claude --port 7801 --p2p-port 7811 --semantic --backbone <checkout>/.vortex/backbone/router.sock --on-ring skills/vortex/adapters/claude.sh --bootstrap /ip4/127.0.0.1/tcp/7812/p2p/<opencode-peer-id>
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
