# Template: replace <checkout> before installing.
# Installed at ~/.config/systemd/user/opencode.service (user unit; enable lingering).
# The OpenCode 2.x server every VORTEX wake talks to.
[Unit]
Description=OpenCode server for the VORTEX agents (port 4096)
After=network-online.target

[Service]
Type=simple
# Sessions inherit this directory unless a request names another.
WorkingDirectory=<checkout>
# OPENCODE_SERVER_PASSWORD (the server's password) and OPENCODE_PASSWORD (the
# same value, for clients); mode 600. 2.x always requires a password.
EnvironmentFile=%h/.config/opencode-local/server.env
# A login shell, so the agent's tools (bun, mix, nix profile) are on PATH
# exactly as they are for the operator.
Environment=BROWSER=true
# Raises the shell tool's two-minute foreground default so one tool call can
# run a full test suite (honoured by our OpenCode fork's local branch).
Environment=OPENCODE_EXPERIMENTAL_BASH_DEFAULT_TIMEOUT_MS=600000
ExecStart=/bin/bash -lc 'exec opencode serve --port 4096 --hostname 127.0.0.1'
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=default.target
