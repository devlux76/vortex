{
  "description": "VORTEX passive peer context (additionalContext) and human-turn recording; no Stop hook, no receipts from timing.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/../../cli/vx.ts", "hook", "context"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/../../cli/vx.ts", "hook", "context"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
